# build artifacts
*.o
*.ko
*.mod
*.mod.c
*.mod.o
# ...but *.mod is a kernel build artifact rule (nvkvm-guest.mod) and it also
# matches go.mod, which is how tests/abi_parity/go.mod got left behind when this
# repo was extracted — the Go package then had no module file and `go test`
# refused to run it at all.
!go.mod
!go.sum
*.symvers
*.order
.tmp_versions/
Module.symvers
modules.builtin
modules.order
*.so
# generated: stub binary embedded for QEMU
src/stub/nvkvm_stub
src/stub/nvkvm_stub_bin.h
# editor
.vscode/
.idea/
# local secrets — never commit
*.key
.env

# python bytecode -- rewritten on every run, so merely running the sweep or a
# perf script dirtied the tree.  That is not cosmetic: sweep_matrix.py refuses
# to spend money from a dirty tree, and CI fails a build that modifies tracked
# files.  Four of these had been committed.
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# built test binaries -- tests/unit/test_ctrl_gate was committed as an ELF that
# the Makefile rebuilds, so running the suite dirtied the tree.
tests/unit/test_objects
tests/unit/test_handle
tests/unit/test_isolate
tests/unit/test_tables
tests/unit/test_open_scm
tests/unit/test_ctrl_gate
tests/unit/mock_stub
tests/unit/test_nvkms_allowlist
tests/unit/test_stub_ptr_sanitize
tests/unit/test_kvm_slot
tests/unit/test_r1_type_dev

# generated at build time by tests/unit/Makefile (the U-5 function, extracted
# from src/stub/nvkvm_stub.c so the test cannot drift from the code it pins)
tests/unit/stub_sanitize.inc
# likewise: the A-21 KVM slot pool, extracted from src/qemu/nvkvm_mmap_host.c
tests/unit/kvm_slot_pool.inc

# U-9 (tests/unit/test_stub_window.c): the compiled suite, plus the window gate
# and the window allocator, extracted from real source at build time.
tests/unit/test_stub_window
tests/unit/stub_window.inc
tests/unit/win_alloc.inc

# tests/unit/test_drm_devinfo.c: the compiled suite, plus the nvidia-drm param
# structs extracted from src/guest/nvkvm_drm.c at build time.
tests/unit/test_drm_devinfo
tests/unit/drm_param_structs.inc
# same trick for R-1: both halves of the type/dev_id cross-check, extracted
# from the QEMU handler and from the stub between explicit markers
tests/unit/r1_type_dev.inc
tests/unit/r1_stub_type_dev.inc

# scripts/sweep.sh run output: results, raw logs pulled off rented boxes,
# and the instance registry the auto-destroy timer reads.
sweep-runs/
