obj-m := nvkvm-guest.o

nvkvm-guest-objs := nvkvm_main.o \
                    nvkvm_ioctl.o \
                    nvkvm_virtio.o \
                    nvkvm_mmap.o \
                    nvkvm_session.o \
                    nvkvm_hostfile.o

ccflags-y := -I$(src)/.. -I$(src)/../..

# Graphics/display layer (DRM render node + virtual KMS head). Compiled in only
# for the graphics module version (NVKVM_GRAPHICS=1, the default). A compute-only
# build (NVKVM_GRAPHICS=0) drops these objects and the -DNVKVM_GRAPHICS define so
# the resulting .ko has no DRM/KMS/modeset code at all — the nvproxy-equivalent.
ifneq ($(NVKVM_GRAPHICS),0)
ccflags-y += -DNVKVM_GRAPHICS
nvkvm-guest-objs += nvkvm_drm.o \
                    nvkvm_kms.o
endif
