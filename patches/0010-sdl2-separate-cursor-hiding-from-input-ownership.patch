From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reindert Pelsma <reindert.pelsma@gmail.com>
Date: Thu, 21 Aug 2026 22:10:00 +0200
Subject: [PATCH 10/10] sdl2: separate "hiding the cursor" from "the guest owns
 your input"

Four defects with one root cause, all found by testing grab mode on real
hardware (RTX 3050, GNOME/Wayland) after 0008 and 0009 made it reachable.

gui_grab conflates two things that were the same before a pointer lock existed:
"this window is hiding the host cursor" and "the guest owns your input".
Upstream sets it from absolute_mouse_grab() on every window-enter, purely for
the first meaning -- no lock is taken.  Once 0009 could take a real lock, every
test of gui_grab became ambiguous, and each one was wrong in a different way:

1. THE ESCAPE DID NOT WORK.  ctrl-alt-g released, then hovering re-locked
   immediately.  Ungrabbing restores the tablet, which makes
   qemu_input_is_absolute() true, which makes the WINDOWEVENT_ENTER branch call
   absolute_mouse_grab() -- and 0009 turned that incidental grab into a lock.
   There was no way back to normal mode.  sdl_grab_start() now takes
   user_initiated and only an explicit grab locks: ctrl-alt-g, the fullscreen
   toggle and -full-screen do; window-enter, mouse-motion and left-click do not.
   The click case matters on its own -- a click stays a click, as in 0006.

2. THE KEYBOARD WAS NEVER GRABBED.  SDL_SetWindowGrab() is mouse-only
   (SDL_SetWindowMouseGrab is its alias) and win32_kbd_set_grab() is a no-op off
   Windows, so a "grabbed" guest never received Super or Alt-Tab -- the
   compositor kept eating them.  Added SDL_SetWindowKeyboardGrab(), which on
   Wayland is zwp_keyboard_shortcuts_inhibit_manager_v1: send shortcuts to the
   application rather than the desktop.  Explicit grabs only.

3. CTRL-ALT-G NEEDED TWO PRESSES.  The hotkey tested gui_grab, which the
   incidental grab had already set, so the first press took the else branch and
   ungrabbed THAT.  It now toggles on the lock, so one press is one toggle.

4. THE TITLE BAR LIED.  It offered "Press Ctrl-Alt-G to exit grab" while merely
   hovering in normal mode, with nothing to exit.  The caption now tracks the
   lock.

The escape survives the keyboard grab: ctrl-alt-g is matched by QEMU own key
handler before anything reaches the guest, so inhibiting the compositor cannot
trap the user.  That invariant is the one thing every design in this area --
QEMU own, VirtualBox host key, the browser Pointer Lock API -- depends on.

Verified interactively on the RTX 3050: normal mode keeps a seamless pointer and
untouched host shortcuts, grab mode locks the pointer and forwards Super to the
guest, one press each way, caption correct in both.
---
--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -66,6 +66,17 @@
 
 static void sdl_update_caption(struct sdl2_console *scon);
 
+/*
+ * nvkvm: true only while an EXPLICIT grab holds the pointer lock.
+ *
+ * gui_grab cannot answer this.  Upstream sets it from absolute_mouse_grab() on
+ * every window-enter, purely to hide the host cursor while the guest device is
+ * absolute -- no lock is taken.  Keying the caption on gui_grab therefore told
+ * the user to "Press Ctrl-Alt-G to exit grab" while merely hovering in normal
+ * mode, with nothing to exit.  Reported on an RTX 3050.
+ */
+static bool nvkvm_sdl_locked;
+
 static struct sdl2_console *get_scon_from_window(uint32_t window_id)
 {
     int i;
@@ -177,7 +188,7 @@
 
     if (!runstate_is_running()) {
         status = " [Stopped]";
-    } else if (gui_grab) {
+    } else if (nvkvm_sdl_locked) {
         if (alt_grab) {
 #ifdef CONFIG_DARWIN
             status = " - Press ⌃⌥⇧G to exit grab";
@@ -377,7 +388,20 @@
     nvkvm_sdl_switching = false;
 }
 
-static void sdl_grab_start(struct sdl2_console *scon)
+/*
+ * nvkvm: user_initiated distinguishes an EXPLICIT grab (ctrl-alt-g, the
+ * fullscreen toggle, the -full-screen option) from upstream's incidental ones.
+ * Only an explicit grab takes the pointer LOCK.  The incidental grabs keep
+ * their original upstream meaning -- hide the host cursor so the two pointers
+ * track seamlessly while the guest device is absolute.
+ *
+ * Without this the escape does not work.  Ungrabbing restores the tablet, which
+ * makes qemu_input_is_absolute() true, which makes the WINDOWEVENT_ENTER branch
+ * call absolute_mouse_grab() on the very next hover -- re-entering the relative
+ * lock.  Measured on an RTX 3050: ctrl-alt-g released and hovering re-locked
+ * immediately, so there was no way back to normal mode.
+ */
+static void sdl_grab_start(struct sdl2_console *scon, bool user_initiated)
 {
     QemuConsole *con = scon ? scon->dcl.con : NULL;
 
@@ -404,7 +428,27 @@
      * ops), so this does not arise here; fixing it properly means reworking
      * upstream's cursor handling, which is a different patch.
      */
-    nvkvm_sdl_grab_set_relative();
+    if (user_initiated) {
+        nvkvm_sdl_grab_set_relative();
+        nvkvm_sdl_locked = true;
+        /*
+         * nvkvm: take the KEYBOARD too, which SDL_SetWindowGrab() below does
+         * NOT do -- that call is mouse-only (SDL_SetWindowMouseGrab is its
+         * alias), and win32_kbd_set_grab() is a no-op off Windows.  Without
+         * this the compositor keeps eating Super, Alt-Tab and the rest, so a
+         * grabbed guest cannot receive its own shortcuts.
+         *
+         * On Wayland SDL implements this with
+         * zwp_keyboard_shortcuts_inhibit_manager_v1, which is precisely "send
+         * shortcuts to the application rather than the desktop".  Only for an
+         * explicit grab: hovering must never take the keyboard.
+         *
+         * The escape survives it -- ctrl-alt-g is matched by QEMU's own key
+         * handler before anything is forwarded to the guest, so inhibiting the
+         * compositor cannot trap the user.
+         */
+        SDL_SetWindowKeyboardGrab(scon->real_window, SDL_TRUE);
+    }
 
     if (guest_cursor) {
         SDL_SetCursor(guest_sprite);
@@ -432,6 +476,10 @@
      * its !qemu_input_is_absolute() test false and the pointer would stay
      * locked with no way out.
      */
+    if (nvkvm_sdl_locked) {
+        SDL_SetWindowKeyboardGrab(scon->real_window, SDL_FALSE);
+    }
+    nvkvm_sdl_locked = false;
     nvkvm_sdl_ungrab_set_absolute();
     sdl_update_caption(scon);
 }
@@ -444,7 +492,7 @@
     SDL_GetWindowSize(scon->real_window, &scr_w, &scr_h);
     if (mouse_x > 0 && mouse_x < scr_w - 1 &&
         mouse_y > 0 && mouse_y < scr_h - 1) {
-        sdl_grab_start(scon);
+        sdl_grab_start(scon, false);
     }
 }
 
@@ -518,7 +566,7 @@
         SDL_SetWindowFullscreen(scon->real_window,
                                 SDL_WINDOW_FULLSCREEN_DESKTOP);
         gui_saved_grab = gui_grab;
-        sdl_grab_start(scon);
+        sdl_grab_start(scon, true);
     } else {
         if (!gui_saved_grab) {
             sdl_grab_end(scon);
@@ -601,8 +649,17 @@
             break;
         case SDL_SCANCODE_G:
             scon->gui_keysym = true;
-            if (!gui_grab) {
-                sdl_grab_start(scon);
+            /*
+             * nvkvm: toggle on the LOCK, not on gui_grab.  Upstream's
+             * absolute_mouse_grab() sets gui_grab on every window-enter merely
+             * to hide the host cursor, so testing it here meant the first
+             * ctrl-alt-g took the else branch and ungrabbed that incidental
+             * grab -- the user had to press it TWICE to lock.  Reported on an
+             * RTX 3050.  nvkvm_sdl_locked is true only while an explicit grab
+             * holds the pointer, so one press is one toggle.
+             */
+            if (!nvkvm_sdl_locked) {
+                sdl_grab_start(scon, true);
             } else if (!gui_fullscreen) {
                 sdl_grab_end(scon);
             }
@@ -692,7 +749,7 @@
         if (!gui_grab &&
             (ev->motion.x > 0 && ev->motion.x < max_x &&
              ev->motion.y > 0 && ev->motion.y < max_y)) {
-            sdl_grab_start(scon);
+            sdl_grab_start(scon, false);
         }
     }
     if (gui_grab || qemu_input_is_absolute(scon->dcl.con) || absolute_enabled) {
@@ -715,7 +772,7 @@
     if (!gui_grab && !qemu_input_is_absolute(scon->dcl.con)) {
         if (ev->type == SDL_MOUSEBUTTONUP && bev->button == SDL_BUTTON_LEFT) {
             /* start grabbing all events */
-            sdl_grab_start(scon);
+            sdl_grab_start(scon, false);
         }
     } else {
         if (ev->type == SDL_MOUSEBUTTONDOWN) {
@@ -1142,7 +1199,7 @@
     sdl_cursor_normal = SDL_GetCursor();
 
     if (gui_fullscreen) {
-        sdl_grab_start(&sdl2_console[0]);
+        sdl_grab_start(&sdl2_console[0], true);
     }
 
     atexit(sdl_cleanup);
-- 
